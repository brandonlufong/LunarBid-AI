# Security headers and caching for the static frontend (Cloudflare Workers assets; Netlify previews read it too).
# The API, uploaded files and any preview hosts must live on *.lunarbid.ai for connect-src/img-src below.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.lunarbid.ai https://*.r2.dev; font-src 'self'; connect-src 'self' https://*.lunarbid.ai https://*.ingest.sentry.io https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Build output has content hashes in file names: cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
