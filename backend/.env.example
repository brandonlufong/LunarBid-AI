PORT=5000
MONGODB_URI=mongodb://localhost:27017/proposal-generator
# At least 32 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
NODE_ENV=development
# HUGGINGFACE_API_KEY=your_huggingface_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Choose one or multiple
GROQ_API_KEY=your_groq_key_here
TOGETHER_API_KEY=your_together_key
OPENROUTER_API_KEY=your_openrouter_key_here
ANTHROPIC_API_KEY=your_anthropic_key

# Optional AI tuning. Check providers and models with: npm run ai:check
# AI_PROVIDER_ORDER=groq,together,openrouter,openai,anthropic
# AI_TIMEOUT_MS=25000          # per provider
# AI_DEADLINE_MS=45000         # whole request
# GROQ_MODEL=llama-3.3-70b-versatile
# TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
# OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
# Webhook endpoint in Stripe: https://<your-api-domain>/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created/updated/deleted/paused/resumed,
#         invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=your_webhook_secret_here

# Stripe Price IDs (get these from Stripe Dashboard)
STRIPE_STARTER_PRICE_ID=price_1SuZBx3ff3W5lQnHYTCofTEQ
STRIPE_PRO_PRICE_ID=price_1SuZFC3ff3W5lQnHpYfh4kTq
# Agency is not purchasable yet (see config/plans.js)
STRIPE_AGENCY_PRICE_ID=price_1SuZGI3ff3W5lQnHUUXWFjLm

# Email: use a transactional provider over SMTP (Postmark, Resend, Amazon SES, Mailgun...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="LunarBid <no-reply@lunarbid.ai>"

# Legacy Gmail fallback (used only when SMTP_HOST is empty; not recommended for production)
EMAIL_SERVICE=gmail
SUPPORT_EMAIL=support@lunarbid.com
SUPPORT_EMAIL_PASSWORD=your_app_password
SUPPORT_TEAM_EMAIL=team@lunarbid.com
SUPPORT_PHONE=+1-xxx-xxx-xxxx

# Application URLs (used for OAuth redirects + password-reset links)
APP_URL=https://lunarbid.ai
# The frontend's public URL: used for CORS, Stripe redirects and links in emails
FRONTEND_URL=http://localhost:5174
# Extra allowed browser origins, comma-separated (for example a staging frontend)
CORS_ORIGINS=
# The API's public URL (used for OAuth callbacks and locally stored uploads)
BACKEND_URL=http://localhost:5000

# ============================================================
# Social sign-in (OAuth). Leave blank to disable a provider.
# Google:  https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: ${BACKEND_URL}/api/auth/google/callback
# GitHub:  https://github.com/settings/developers  (New OAuth App)
#   Authorization callback URL: ${BACKEND_URL}/api/auth/github/callback
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Error reporting (https://sentry.io). Leave empty to disable.
SENTRY_DSN=
# Number of proxies in front of the API (1 for most hosts). Used for accurate rate limiting.
TRUST_PROXY=1

# File storage for logos (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces).
# Leave S3_BUCKET empty in development to store files in ./uploads.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket or its CDN, e.g. https://files.lunarbid.ai
S3_PUBLIC_URL=

# How long a sign-in lasts without use (renewed automatically while active)
# SESSION_TTL=7d

# Maximum proposals a user can email to clients per day
SEND_LIMIT_PER_DAY=30
